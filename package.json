{
	"name": "github-cursor-trail",
	"version": "0.1.0",
	"description": "零依赖、框架无关的网格吸附式鼠标拖尾 TypeScript 库",
	"keywords": [
		"cursor",
		"grid",
		"mouse-trail",
		"trail",
		"typescript",
		"zero-dependency"
	],
	"homepage": "https://github.com/mulingyuer/github-cursor-trail#readme",
	"bugs": {
		"url": "https://github.com/mulingyuer/github-cursor-trail/issues"
	},
	"license": "MIT",
	"author": "mulingyuer",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mulingyuer/github-cursor-trail.git"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/cursor-trail.js",
	"module": "./dist/cursor-trail.js",
	"types": "./dist/index.d.ts",
	"unpkg": "./dist/cursor-trail.umd.js",
	"jsdelivr": "./dist/cursor-trail.umd.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/cursor-trail.js",
			"default": "./dist/cursor-trail.js"
		}
	},
	"scripts": {
		"dev": "vite --config vite.demo.config.ts",
		"build": "pnpm run build:lib && pnpm run build:types && pnpm run build:demo",
		"build:lib": "vite build --config vite.lib.config.ts",
		"build:types": "tsc -p tsconfig.build.json",
		"build:demo": "node scripts/build-demo.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "oxlint .",
		"format": "oxfmt --write . \"!dist/**\" \"!docs/**\" \"!node_modules/**\" \"!build/**\" \"!coverage/**\" \"!**/*.md\" \"!*.md\" \"!**/*.html\" \"!*.html\" \"!pnpm-lock.yaml\" \"!.github/**\" \"!release-please-config.json\" \"!.release-please-manifest.json\"",
		"format:check": "oxfmt --check . \"!dist/**\" \"!docs/**\" \"!node_modules/**\" \"!build/**\" \"!coverage/**\" \"!**/*.md\" \"!*.md\" \"!**/*.html\" \"!*.html\" \"!pnpm-lock.yaml\" \"!.github/**\" \"!release-please-config.json\" \"!.release-please-manifest.json\"",
		"check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
		"preview": "vite preview --config vite.demo.config.ts"
	},
	"devDependencies": {
		"oxfmt": "0.76.0",
		"oxlint": "1.91.0",
		"typescript": "7.0.2",
		"vite": "8.3.6"
	},
	"engines": {
		"node": ">=24.22"
	},
	"packageManager": "pnpm@12.15.0"
}
